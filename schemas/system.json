{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.convoz.dev/v1/system.json",
  "title": "messages.system_json v1",
  "description": "Ids and enums only (no text: names and titles are looked up at render time, so a rename or a scrub never leaves stale text), except the title of conversation.renamed, the two handles of member.renamed (an agent's handles are never scrubbed and a retired one is never reused, I-51) and the plan items a plan.changed line quotes (what the line said must not change when the plan does). <= 2048 bytes (DB CHECK). Written only by the server.",
  "type": "object",
  "oneOf": [
    {
      "$ref": "#/$defs/byOnly"
    },
    {
      "$ref": "#/$defs/renamed"
    },
    {
      "$ref": "#/$defs/subjectOnly"
    },
    {
      "$ref": "#/$defs/subjectBy"
    },
    {
      "$ref": "#/$defs/added"
    },
    {
      "$ref": "#/$defs/paused"
    },
    {
      "$ref": "#/$defs/handleChanged"
    },
    {
      "$ref": "#/$defs/planChanged"
    },
    {
      "$ref": "#/$defs/unresponsive"
    }
  ],
  "$defs": {
    "ref": {
      "type": "integer",
      "minimum": 1
    },
    "byOnly": {
      "type": "object",
      "required": [
        "v",
        "t",
        "by"
      ],
      "additionalProperties": false,
      "properties": {
        "v": {
          "const": 1
        },
        "t": {
          "enum": [
            "conversation.resumed",
            "conversation.restored"
          ]
        },
        "by": {
          "$ref": "#/$defs/ref"
        }
      }
    },
    "subjectOnly": {
      "type": "object",
      "required": [
        "v",
        "t",
        "identity"
      ],
      "additionalProperties": false,
      "properties": {
        "v": {
          "const": 1
        },
        "t": {
          "enum": [
            "member.left",
            "member.disabled"
          ]
        },
        "identity": {
          "$ref": "#/$defs/ref"
        }
      }
    },
    "subjectBy": {
      "type": "object",
      "required": [
        "v",
        "t",
        "identity",
        "by"
      ],
      "additionalProperties": false,
      "properties": {
        "v": {
          "const": 1
        },
        "t": {
          "enum": [
            "member.requested",
            "member.removed",
            "member.approved",
            "member.declined"
          ]
        },
        "identity": {
          "$ref": "#/$defs/ref"
        },
        "by": {
          "$ref": "#/$defs/ref"
        }
      }
    },
    "added": {
      "type": "object",
      "required": [
        "v",
        "t",
        "identity",
        "by",
        "via"
      ],
      "additionalProperties": false,
      "properties": {
        "v": {
          "const": 1
        },
        "t": {
          "const": "member.added"
        },
        "identity": {
          "$ref": "#/$defs/ref"
        },
        "by": {
          "$ref": "#/$defs/ref"
        },
        "via": {
          "enum": [
            "mention",
            "add",
            "create"
          ]
        },
        "history": {
          "enum": [
            "since_now",
            "full"
          ]
        }
      }
    },
    "paused": {
      "type": "object",
      "required": [
        "v",
        "t",
        "streak"
      ],
      "additionalProperties": false,
      "properties": {
        "v": {
          "const": 1
        },
        "t": {
          "const": "conversation.paused"
        },
        "streak": {
          "const": 20
        }
      }
    },
    "handle": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,39}$"
    },
    "renamed": {
      "type": "object",
      "required": [
        "v",
        "t",
        "by"
      ],
      "additionalProperties": false,
      "properties": {
        "v": {
          "const": 1
        },
        "t": {
          "const": "conversation.renamed"
        },
        "by": {
          "$ref": "#/$defs/ref"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "The new title, quoted by the line. The one text a system line holds: a later rename must not change what this line said."
        }
      }
    },
    "handleChanged": {
      "type": "object",
      "required": [
        "v",
        "t",
        "identity",
        "from",
        "to"
      ],
      "additionalProperties": false,
      "properties": {
        "v": {
          "const": 1
        },
        "t": {
          "const": "member.renamed"
        },
        "identity": {
          "$ref": "#/$defs/ref"
        },
        "from": {
          "$ref": "#/$defs/handle"
        },
        "to": {
          "$ref": "#/$defs/handle"
        }
      }
    },
    "planChanged": {
      "type": "object",
      "required": [
        "v",
        "t",
        "identity"
      ],
      "additionalProperties": false,
      "anyOf": [
        {
          "required": [
            "done"
          ]
        },
        {
          "required": [
            "waiting"
          ]
        }
      ],
      "properties": {
        "v": {
          "const": 1
        },
        "t": {
          "const": "plan.changed"
        },
        "identity": {
          "$ref": "#/$defs/ref"
        },
        "done": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "description": "The items the agent finished, as it wrote them."
        },
        "now": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "description": "What the agent does now."
        },
        "next": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "description": "What the agent does next."
        },
        "waiting": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "description": "What newly waits on the owner."
        }
      }
    },
    "unresponsive": {
      "type": "object",
      "required": [
        "v",
        "t",
        "identity",
        "liveness"
      ],
      "additionalProperties": false,
      "properties": {
        "v": {
          "const": 1
        },
        "t": {
          "const": "agent.unresponsive"
        },
        "identity": {
          "$ref": "#/$defs/ref"
        },
        "liveness": {
          "enum": [
            "not_responding",
            "logged_out"
          ]
        }
      }
    }
  }
}
