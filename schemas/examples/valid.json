      "title": "Ask state guard",
      "fallback": "Diff of ask.ts: adds a NEXT table so an ask moves from open only to answered, snoozed or dismissed.",
      "props": {
        "mode": "diff",
        "text": "--- a/ask.ts\n+++ b/ask.ts\n@@ -1,3 +1,8 @@\n+const NEXT = {\n+  open: ['answered', 'snoozed', 'dismissed'],\n+  answered: [],\n+  dismissed: [],\n+};\n export function move(a, to) {\n-  a.state = to;\n+  if (!NEXT[a.state].includes(to)) throw new Error('bad move');\n+  a.state = to;\n }\n"
      }
    }
