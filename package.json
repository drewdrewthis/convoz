{
  "name": "convoz",
  "private": true,
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build:go": "make -C apps/convoz build",
    "e2e": "pnpm --filter @convoz/e2e test",
    "proof": "python3 -I scripts/proof_report.py e2e/report/results.json e2e/report/proof.html",
    "parity": "python3 -I specs/scripts/parity.py specs e2e/tests e2e/report/results.json"
  }
}
