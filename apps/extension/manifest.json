{
  "manifest_version": 3,
  "name": "Convoz",
  "version": "0.1.0",
  "description": "Convoz next to the page you are on. Share a tab with the agents of a conversation: they read it, never its secrets.",
  "minimum_chrome_version": "116",
  "key": "",
  "permissions": ["sidePanel", "activeTab", "scripting", "storage"],
  "optional_host_permissions": ["https://*/*", "http://localhost/*"],
  "background": { "service_worker": "background.js" },
  "side_panel": { "default_path": "sidepanel.html" },
  "action": { "default_title": "Open Convoz" }
}
