{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.convoz.dev/v1/app-result.json",
  "title": "messages.app_result_json v1 (proposed column; only on via_app messages)",
  "description": "What an app sent back, stored next to the human-readable body (= summary). <= 4096 bytes canonical. Semantic checks against the target app: source equals the app type; picker ids are option ids and the count is within min/max (exactly 1 when not multi); checklist ids are item ids and count >= minChecked; form keys are field ids, required fields present, each value matches its field kind and limits.",
  "type": "object",
  "required": [
    "v",
    "source",
    "summary",
    "value"
  ],
  "additionalProperties": false,
  "properties": {
    "v": {
      "const": 1
    },
    "source": {
      "enum": [
        "picker",
        "checklist",
        "form",
        "frame"
      ]
    },
    "summary": {
      "$ref": "common.json#/$defs/summary"
    },
    "value": {}
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "source": {
            "const": "picker"
          }
        },
        "required": [
          "source"
        ]
      },
      "then": {
        "properties": {
          "value": {
            "type": "object",
            "required": [
              "selected"
            ],
            "additionalProperties": false,
            "properties": {
              "selected": {
                "type": "array",
                "minItems": 1,
                "maxItems": 12,
                "uniqueItems": true,
                "items": {
                  "$ref": "common.json#/$defs/id"
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "source": {
            "const": "checklist"
          }
        },
        "required": [
          "source"
        ]
      },
      "then": {
        "properties": {
          "value": {
            "type": "object",
            "required": [
              "checked"
            ],
            "additionalProperties": false,
            "properties": {
              "checked": {
                "type": "array",
                "maxItems": 50,
                "uniqueItems": true,
                "items": {
                  "$ref": "common.json#/$defs/id"
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "source": {
            "const": "form"
          }
        },
        "required": [
          "source"
        ]
      },
      "then": {
        "properties": {
          "value": {
            "type": "object",
            "required": [
              "fields"
            ],
            "additionalProperties": false,
            "properties": {
              "fields": {
                "type": "object",
                "maxProperties": 12,
                "propertyNames": {
                  "$ref": "common.json#/$defs/id"
                },
                "additionalProperties": {
                  "anyOf": [
                    {
                      "allOf": [
                        {
                          "$ref": "common.json#/$defs/multiline"
                        }
                      ],
                      "maxLength": 2000,
                      "type": "string"
                    },
                    {
                      "$ref": "common.json#/$defs/num"
                    },
                    {
                      "type": "boolean"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            }
          }
        }
      }
    }
  ]
}
