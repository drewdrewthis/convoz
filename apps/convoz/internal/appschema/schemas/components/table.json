{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.convoz.dev/v1/components/table.json",
  "title": "Tier 1 table props v1",
  "description": "Rows are arrays in column order. Semantic checks: every row has exactly columns.length cells; highlightRow < rows.length.",
  "type": "object",
  "required": [
    "columns",
    "rows"
  ],
  "additionalProperties": false,
  "properties": {
    "caption": {
      "$ref": "../common.json#/$defs/line140"
    },
    "columns": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "required": [
          "label"
        ],
        "additionalProperties": false,
        "properties": {
          "label": {
            "$ref": "../common.json#/$defs/line40"
          },
          "kind": {
            "enum": [
              "text",
              "number"
            ]
          },
          "align": {
            "enum": [
              "left",
              "right"
            ]
          }
        }
      }
    },
    "rows": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "array",
        "minItems": 1,
        "maxItems": 12,
        "items": {
          "anyOf": [
            {
              "allOf": [
                {
                  "$ref": "../common.json#/$defs/line"
                }
              ],
              "maxLength": 200,
              "type": "string"
            },
            {
              "$ref": "../common.json#/$defs/num"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "sortable": {
      "type": "boolean"
    },
    "highlightRow": {
      "type": "integer",
      "minimum": 0,
      "maximum": 199
    }
  }
}
